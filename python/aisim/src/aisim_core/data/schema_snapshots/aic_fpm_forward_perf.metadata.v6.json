{
  "$defs": {
    "FpmCacheGroup": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "blocks_per_request": {
                "type": "null"
              },
              "prefill_checkpoint_blocks": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "state"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "blocks_per_request": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "sliding_window": {
                "type": "null"
              }
            },
            "required": [
              "blocks_per_request"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "convolution"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "sliding_window": {
                "type": "integer"
              }
            },
            "required": [
              "sliding_window"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "prefill_checkpoint_alignment": {
                "type": "integer"
              }
            },
            "required": [
              "prefill_checkpoint_alignment"
            ]
          },
          "then": {
            "properties": {
              "prefill_checkpoint_blocks": {
                "const": 1
              }
            },
            "required": [
              "prefill_checkpoint_blocks"
            ]
          }
        }
      ],
      "description": "Rank-local physical cache pages for one attention, convolution or state group.\n\nIn an attention or convolution group, page bytes include all group layers\nand runtime padding. The retention window does not replace the logical\ncontext used for FPM timing queries.\n\nA state group has no window and holds ``blocks_per_request`` blocks of\n``page_size_bytes`` for every running request. Its ``page_size_bytes`` is\none pool block: every byte that one block ID reserves in the shared pool.\nThat can be more than the bytes of the group's own layers. Its\n``block_size_tokens`` is the block size of vLLM's state spec, as the\nruntime probe records it: the Mamba block (the scheduler block in\n``align`` mode, ``max_model_len`` in mode ``none``) or the ring block.\nSizing and replay do not read it yet.\n\n``blocks_per_request`` counts the pool blocks that a running request holds\nbetween block boundaries. For a Mamba spec, that is ``1 + k``, where ``k``\nis the spec's ``num_speculative_blocks``. Grouped execution forbids\nspeculative decoding, so ``k`` is 0 there. A ring spec, such as\n``KpoolTailSpec`` or ``CircularBufferSpec`` in vLLM 0.31.0, holds 1 block\nfor the whole life of the request in every mode. When a request crosses a\nblock boundary in ``align`` mode, a Mamba group also holds the previous\nblock for one or two steps. vLLM's startup sizing in that mode counts\n``2 + k + c`` blocks for a Mamba group, where ``c`` is the spec's\n``num_prefill_checkpoint_blocks``. It counts 1 block for a ring group.\n\nFour optional fields describe the group beyond its geometry.\n``prefix_cacheable`` says whether vLLM's manager for the group takes part in\nprefix caching. A ring spec does not. ``transfer_bytes_per_block`` is the\nbytes that vLLM's P/D connector reads for one block of the group in a\ntransfer on one TP rank, for the vLLM version of the deployment. It can be\nlarger than the page, because the connector reads a block in regions that\nlayers of other groups can share. The probe import of a vLLM 0.33.0 record\ndoes not write it.\n``prefill_checkpoint_blocks`` (0 or 1, state groups only) and\n``prefill_checkpoint_alignment`` (positive, with one checkpoint block) are\nthe prefill checkpoint settings of a Mamba spec.",
      "properties": {
        "block_size_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Block Size Tokens",
          "type": "integer"
        },
        "blocks_per_request": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocks Per Request"
        },
        "kind": {
          "enum": [
            "attention",
            "convolution",
            "state"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "num_layers": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Num Layers",
          "type": "integer"
        },
        "page_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740992,
          "title": "Page Size Bytes",
          "type": "integer"
        },
        "prefill_checkpoint_alignment": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 4294967295,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefill Checkpoint Alignment"
        },
        "prefill_checkpoint_blocks": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefill Checkpoint Blocks"
        },
        "prefix_cacheable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix Cacheable"
        },
        "sliding_window": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 4294967295,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sliding Window"
        },
        "transfer_bytes_per_block": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740992,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer Bytes Per Block"
        }
      },
      "required": [
        "name",
        "kind",
        "num_layers",
        "block_size_tokens",
        "page_size_bytes"
      ],
      "title": "FpmCacheGroup",
      "type": "object"
    },
    "FpmMambaCache": {
      "additionalProperties": false,
      "description": "One attention group and padded Mamba groups share the observed pool.",
      "properties": {
        "block_size_tokens": {
          "maximum": 4294967295,
          "minimum": 2,
          "title": "Block Size Tokens",
          "type": "integer"
        },
        "num_speculative_states": {
          "maximum": 5,
          "minimum": 0,
          "title": "Num Speculative States",
          "type": "integer"
        },
        "page_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740992,
          "title": "Page Size Bytes",
          "type": "integer"
        },
        "prefix_match_unit": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Prefix Match Unit",
          "type": "integer"
        },
        "state_groups": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "State Groups",
          "type": "integer"
        },
        "state_storage": {
          "const": "full_state",
          "title": "State Storage",
          "type": "string"
        }
      },
      "required": [
        "state_storage",
        "block_size_tokens",
        "page_size_bytes",
        "state_groups",
        "prefix_match_unit",
        "num_speculative_states"
      ],
      "title": "FpmMambaCache",
      "type": "object"
    },
    "FpmResourceProfile": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cache_layout": {
                "const": "linear"
              }
            },
            "required": [
              "cache_layout"
            ]
          },
          "then": {
            "properties": {
              "cache_groups": {
                "maxItems": 0
              },
              "kv_bytes_per_token": {
                "type": "integer"
              },
              "mamba_cache": {
                "type": "null"
              }
            },
            "required": [
              "kv_bytes_per_token"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cache_layout": {
                "const": "grouped"
              }
            },
            "required": [
              "cache_layout"
            ]
          },
          "then": {
            "properties": {
              "cache_groups": {
                "minItems": 1
              },
              "kv_bytes_per_token": {
                "type": "null"
              },
              "mamba_cache": {
                "type": "null"
              }
            },
            "required": [
              "cache_groups"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cache_layout": {
                "const": "unmodeled"
              }
            },
            "required": [
              "cache_layout"
            ]
          },
          "then": {
            "properties": {
              "cache_groups": {
                "maxItems": 0
              },
              "kv_bytes_per_token": {
                "type": "null"
              },
              "mamba_cache": {
                "type": "null"
              },
              "runtime_memory": {
                "type": "object"
              }
            },
            "required": [
              "runtime_memory"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cache_layout": {
                "const": "mamba_align"
              }
            },
            "required": [
              "cache_layout"
            ]
          },
          "then": {
            "properties": {
              "cache_groups": {
                "maxItems": 0
              },
              "kv_bytes_per_token": {
                "type": "null"
              },
              "mamba_cache": {
                "type": "object"
              },
              "runtime_memory": {
                "type": "object"
              }
            },
            "required": [
              "runtime_memory",
              "mamba_cache"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "runtime_memory": {
                "type": "object"
              }
            },
            "required": [
              "runtime_memory"
            ]
          },
          "then": {
            "properties": {
              "activations_bytes": {
                "type": "null"
              },
              "comm_overhead_bytes": {
                "type": "null"
              },
              "runtime_overhead_bytes": {
                "type": "null"
              },
              "weights_bytes": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Rank-local cache geometry and optional memory evidence.\n\n``max_num_tokens`` and ``max_batch_size`` apply to each attention-DP rank,\nnot the summed worker iteration used to query FPM timings. Complete declared\nnon-KV bytes establish conservative bounds and exclude separate CUDA graph\nreservations. Runtime capacity instead requires the exact recorded settings.",
      "properties": {
        "activations_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activations Bytes"
        },
        "cache_groups": {
          "items": {
            "$ref": "#/$defs/FpmCacheGroup"
          },
          "title": "Cache Groups",
          "type": "array"
        },
        "cache_layout": {
          "enum": [
            "linear",
            "grouped",
            "unmodeled",
            "mamba_align"
          ],
          "title": "Cache Layout",
          "type": "string"
        },
        "comm_overhead_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comm Overhead Bytes"
        },
        "kv_bytes_per_token": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740992,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kv Bytes Per Token"
        },
        "mamba_cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/FpmMambaCache"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_batch_size": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Max Batch Size",
          "type": "integer"
        },
        "max_num_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Max Num Tokens",
          "type": "integer"
        },
        "provenance": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provenance",
          "type": "string"
        },
        "runtime_memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/FpmRuntimeMemoryProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_overhead_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Overhead Bytes"
        },
        "weights_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Bytes"
        }
      },
      "required": [
        "cache_layout",
        "max_num_tokens",
        "max_batch_size",
        "provenance"
      ],
      "title": "FpmResourceProfile",
      "type": "object"
    },
    "FpmRuntimeMemoryProfile": {
      "additionalProperties": false,
      "description": "Observed rank-local cache capacity for the exact runtime configuration.\n\nThis capacity already accounts for runtime graph and workspace reservations.\nIt is not a non-KV memory limit and must not be rescaled to another setting.\nThe three optional prefix-caching fields record the settings that the probe\nran with. They are evidence only: selection, sizing and replay do not read\nthem, and the simulated deployment decides prefix caching.",
      "properties": {
        "enable_prefix_caching": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Prefix Caching"
        },
        "gpu_memory_utilization": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Gpu Memory Utilization",
          "type": "number"
        },
        "hash_block_size_tokens": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Block Size Tokens"
        },
        "kv_cache_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740992,
          "title": "Kv Cache Bytes",
          "type": "integer"
        },
        "mamba_cache_mode": {
          "anyOf": [
            {
              "enum": [
                "none",
                "align"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mamba Cache Mode"
        },
        "max_model_len": {
          "exclusiveMinimum": 0,
          "maximum": 18446744073709551615,
          "title": "Max Model Len",
          "type": "integer"
        },
        "provenance": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provenance",
          "type": "string"
        },
        "runtime_framework_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Framework Version"
        }
      },
      "required": [
        "kv_cache_bytes",
        "gpu_memory_utilization",
        "max_model_len",
        "provenance"
      ],
      "title": "FpmRuntimeMemoryProfile",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "aic_fpm_forward_perf.metadata/v6",
  "additionalProperties": true,
  "description": "``fpm/fpm_forward_perf.metadata.json`` for ``aic_fpm_forward_perf/v6``.\n\nCollectors add provenance keys over time, so unknown keys are allowed; the fields below are the ones\nAISim reads. ``resources`` is optional: user configuration overrides it, and an entry without it needs the\nuser to supply resources before cache sizing or replay.",
  "properties": {
    "backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "backend_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Version"
    },
    "configuration_selector": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "properties": {
        "cp": {
          "minimum": 1,
          "type": "integer"
        },
        "dp": {
          "minimum": 1,
          "type": "integer"
        },
        "moe_ep": {
          "minimum": 1,
          "type": "integer"
        },
        "moe_tp": {
          "minimum": 1,
          "type": "integer"
        },
        "pp": {
          "minimum": 1,
          "type": "integer"
        },
        "tp": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "Configuration Selector"
    },
    "coordinate_system": {
      "const": "iteration_totals_balanced_v1",
      "title": "Coordinate System",
      "type": "string"
    },
    "measurement_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Policy"
    },
    "measurement_repeats": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Repeats"
    },
    "metadata_provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Provenance"
    },
    "model_paths": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Paths"
    },
    "parquet_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parquet Sha256"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/FpmResourceProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_name": {
      "const": "aic_fpm_forward_perf",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 6,
      "description": "Library schema version; only 6 is supported.",
      "title": "Schema Version",
      "type": "integer"
    },
    "system": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System"
    },
    "warmup_repeats": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warmup Repeats"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "row_count"
  ],
  "title": "FpmLibraryMetadata",
  "type": "object"
}
